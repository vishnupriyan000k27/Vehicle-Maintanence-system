    private String generateReportContent(String type, String fromDate, String toDate) {
        StringBuilder report = new StringBuilder();
        report.append("=== VEHICLE MAINTENANCE SYSTEM REPORT ===\n\n");
        report.append("Report Type: ").append(type.toUpperCase()).append("\n");
        report.append("Period: ").append(fromDate).append(" to ").append(toDate).append("\n");
        report.append("Generated: ").append(LocalDate.now()).append("\n\n");
        
        switch (type) {
            case "maintenance":
                report.append("MAINTENANCE HISTORY REPORT\n");
                report.append("===========================\n\n");
                for (MaintenanceRecord mr : maintenanceRecords) {
                    if ((mr.date.isAfter(LocalDate.parse(fromDate)) || mr.date.isEqual(LocalDate.parse(fromDate))) &&
                        (mr.date.isBefore(LocalDate.parse(toDate)) || mr.date.isEqual(LocalDate.parse(toDate)))) {
                        report.append(String.format("Vehicle: %s\n", mr.vehicle));
                        report.append(String.format("Service: %s | Date: %s\n", mr.serviceType, mr.date));
                        report.append(String.format("Cost: $%.2f | Status: %s\n", mr.cost, mr.status));
                        report.append(String.format("Notes: %s\n\n", mr.notes));
                    }
                }
                break;
                
            case "expense":
                report.append("EXPENSE ANALYSIS REPORT\n");
                report.append("=======================\n\n");
                double totalExpenses = 0;
                Map<String, Double> categoryTotals = new HashMap<>();
                
                for (Expense exp : expenses) {
                    if ((exp.date.isAfter(LocalDate.parse(fromDate)) || exp.date.isEqual(LocalDate.parse(fromDate))) &&
                        (exp.date.isBefore(LocalDate.parse(toDate)) || exp.date.isEqual(LocalDate.parse(toDate)))) {
                        totalExpenses += exp.amount;
                        categoryTotals.put(exp.category, 
                            categoryTotals.getOrDefault(exp.category, 0.0) + exp.amount);
                    }
                }
                
                report.append("Category-wise Breakdown:\n");
                for (Map.Entry<String, Double> entry : categoryTotals.entrySet()) {
                    double percentage = (entry.getValue() / totalExpenses) * 100;
                    report.append(String.format("%-15s: $%.2f (%.1f%%)\n", 
                        entry.getKey(), entry.getValue(), percentage));
                }
                report.append(String.format("\nTotal Expenses: $%.2f\n", totalExpenses));
                break;
                
            case "vehicle":
                report.append("VEHICLE STATUS REPORT\n");
                report.append("=====================\n\n");
                for (Vehicle v : vehicles) {
                    report.append(String.format("Vehicle: %s %s (%d)\n", v.make, v.model, v.year));
                    report.append(String.format("License: %s | VIN: %s\n", v.licensePlate, v.vin));
                    report.append(String.format("Mileage: %d | Status: %s\n\n", v.mileage, v.status));
                }
                break;
                
            default:
                report.append("CUSTOM REPORT\n");
                report.append("=============\n\n");
                report.append("Summary Statistics:\n");
                report.append(String.format("Total Vehicles: %d\n", vehicles.size()));
                report.append(String.format("Active Vehicles: %d\n", 
                    vehicles.stream().filter(v -> "Active".equals(v.status)).count()));
                report.append(String.format("Total Maintenance Records: %d\n", maintenanceRecords.size()));
                report.append(String.format("Total Expenses: $%.2f\n", 
                    expenses.stream().mapToDouble(e -> e.amount).sum()));
                break;
        }
        
        return report.toString();
    }
    
