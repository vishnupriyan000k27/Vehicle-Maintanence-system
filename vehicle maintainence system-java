    private void deleteVehicle() {
        int selectedRow = vehicleTable.getSelectedRow();
        if (selectedRow == -1) {
            JOptionPane.showMessageDialog(this, "Please select a vehicle to delete!");
            return;
        }
        
        int vehicleId = (int) vehicleTableModel.getValueAt(selectedRow, 0);
        String vehicleName = vehicleTableModel.getValueAt(selectedRow, 1) + " " + 
                            vehicleTableModel.getValueAt(selectedRow, 2);
        
        int confirm = JOptionPane.showConfirmDialog(this, 
            "Are you sure you want to delete " + vehicleName + "?\nThis will also delete related maintenance and expense records.",
            "Confirm Delete", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);
        
        if (confirm == JOptionPane.YES_OPTION) {
            // Remove vehicle
            vehicles.removeIf(v -> v.id == vehicleId);
            
            // Remove related maintenance records
            maintenanceRecords.removeIf(mr -> mr.vehicle.contains(vehicleName));
            
            // Remove related expenses
            expenses.removeIf(exp -> exp.vehicle.contains(vehicleName));
            
            refreshVehicleTable();
            refreshMaintenanceTable();
            refreshExpenseTable();
            updateDashboard();
            JOptionPane.showMessageDialog(this, "Vehicle and related records deleted successfully!");
        }
    }
    
    private void viewVehicleDetails() {
        int selectedRow = vehicleTable.getSelectedRow();
        if (selectedRow == -1) {
            JOptionPane.showMessageDialog(this, "Please select a vehicle to view details!");
            return;
        }
        
        int vehicleId = (int) vehicleTableModel.getValueAt(selectedRow, 0);
        Vehicle vehicle = vehicles.stream()
                .filter(v -> v.id == vehicleId)
                .findFirst()
                .orElse(null);
        
        if (vehicle == null) return;
        
        // Get maintenance history for this vehicle
        List<MaintenanceRecord> vehicleMaintenance = new ArrayList<>();
        for (MaintenanceRecord mr : maintenanceRecords) {
            if (mr.vehicle.contains(vehicle.make) && mr.vehicle.contains(vehicle.model)) {
                vehicleMaintenance.add(mr);
            }
        }
        
        // Get expenses for this vehicle
        List<Expense> vehicleExpenses = new ArrayList<>();
        for (Expense exp : expenses) {
            if (exp.vehicle.contains(vehicle.make) && exp.vehicle.contains(vehicle.model)) {
                vehicleExpenses.add(exp);
            }
        }
        
        StringBuilder details = new StringBuilder();
        details.append("=== VEHICLE DETAILS ===\n\n");
        details.append(String.format("Make: %s\n", vehicle.make));
        details.append(String.format("Model: %s\n", vehicle.model));
        details.append(String.format("Year: %d\n", vehicle.year));
        details.append(String.format("License Plate: %s\n", vehicle.licensePlate));
        details.append(String.format("VIN: %s\n", vehicle.vin));
        details.append(String.format("Mileage: %d\n", vehicle.mileage));
        details.append(String.format("Status: %s\n\n", vehicle.status));
        
        details.append("=== MAINTENANCE HISTORY ===\n");
        if (vehicleMaintenance.isEmpty()) {
            details.append("No maintenance records found.\n");
        } else {
            for (MaintenanceRecord mr : vehicleMaintenance) {
                details.append(String.format("\nService: %s\n", mr.serviceType));
                details.append(String.format("Date: %s | Next Due: %s\n", mr.date, mr.nextDue));
                details.append(String.format("Cost: $%.2f | Status: %s\n", mr.cost, mr.status));
                details.append(String.format("Notes: %s\n", mr.notes));
            }
        }
        
        details.append("\n=== EXPENSE SUMMARY ===\n");
        if (vehicleExpenses.isEmpty()) {
            details.append("No expense records found.\n");
        } else {
            double totalExpenses = vehicleExpenses.stream().mapToDouble(e -> e.amount).sum();
            details.append(String.format("Total Expenses: $%.2f\n", totalExpenses));
            details.append(String.format("Number of Records: %d\n", vehicleExpenses.size()));
        }
        
        JTextArea textArea = new JTextArea(details.toString());
        textArea.setEditable(false);
        textArea.setFont(new Font("Monospaced", Font.PLAIN, 12));
        
        JScrollPane scrollPane = new JScrollPane(textArea);
        scrollPane.setPreferredSize(new Dimension(500, 400));
        
        JOptionPane.showMessageDialog(this, scrollPane, "Vehicle Details", JOptionPane.INFORMATION_MESSAGE);
    }
    
