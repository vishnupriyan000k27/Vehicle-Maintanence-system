    private void showExpenseChart() {
        // Simple expense chart using a dialog with data
        Map<String, Double> categoryTotals = new HashMap<>();
        for (Expense exp : expenses) {
            categoryTotals.put(exp.category, 
                categoryTotals.getOrDefault(exp.category, 0.0) + exp.amount);
        }
        
        StringBuilder chart = new StringBuilder();
        chart.append("=== EXPENSE ANALYSIS CHART ===\n\n");
        chart.append("Category-wise Expenses:\n");
        chart.append("------------------------\n");
        
        for (Map.Entry<String, Double> entry : categoryTotals.entrySet()) {
            chart.append(String.format("%-15s: $%.2f\n", entry.getKey(), entry.getValue()));
        }
        
        double totalExpenses = expenses.stream().mapToDouble(e -> e.amount).sum();
        chart.append("\nTotal Expenses: $").append(String.format("%.2f", totalExpenses)).append("\n");
        
        JTextArea chartArea = new JTextArea(chart.toString());
        chartArea.setEditable(false);
        chartArea.setFont(new Font("Monospaced", Font.PLAIN, 12));
        
        JScrollPane scrollPane = new JScrollPane(chartArea);
        scrollPane.setPreferredSize(new Dimension(400, 300));
        
        JOptionPane.showMessageDialog(this, scrollPane, "Expense Analysis Chart", JOptionPane.INFORMATION_MESSAGE);
    }
    
    private void exportExpenses() {
        JFileChooser fileChooser = new JFileChooser();
        fileChooser.setDialogTitle("Export Expenses");
        fileChooser.setSelectedFile(new java.io.File("expenses_export.csv"));
        
        if (fileChooser.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {
            java.io.File file = fileChooser.getSelectedFile();
            try (java.io.PrintWriter writer = new java.io.PrintWriter(file)) {
                // Write header
                writer.println("ID,Vehicle,Category,Date,Amount,Description,Receipt");
                
                // Write data
                for (Expense exp : expenses) {
                    writer.println(String.format("%d,%s,%s,%s,%.2f,%s,%s",
                        exp.id, exp.vehicle, exp.category, exp.date,
                        exp.amount, exp.description, exp.receipt));
                }
                
                JOptionPane.showMessageDialog(this, 
                    "Expenses exported successfully to:\n" + file.getAbsolutePath());
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, 
                    "Error exporting expenses: " + ex.getMessage(), 
                    "Export Error", JOptionPane.ERROR_MESSAGE);
            }
        }
    }
    
