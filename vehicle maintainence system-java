    private void refreshMaintenanceTable() {
        maintenanceTableModel.setRowCount(0);
        for (MaintenanceRecord mr : maintenanceRecords) {
            maintenanceTableModel.addRow(new Object[]{
                mr.id, mr.vehicle, mr.serviceType, mr.date.format(dateFormatter),
                mr.nextDue.format(dateFormatter), String.format("$%.2f", mr.cost),
                mr.status, mr.notes
            });
        }
    }
    
    private void refreshExpenseTable() {
        expenseTableModel.setRowCount(0);
        for (Expense exp : expenses) {
            expenseTableModel.addRow(new Object[]{
                exp.id, exp.vehicle, exp.category, exp.date.format(dateFormatter),
                String.format("$%.2f", exp.amount), exp.description, exp.receipt
            });
        }
    }
    
    private void updateDashboard() {
        int totalVehicles = vehicles.size();
        int pendingMaintenance = (int) maintenanceRecords.stream()
                .filter(mr -> "Pending".equals(mr.status))
                .count();
        
        double monthlyExpenses = expenses.stream()
                .filter(e -> e.date.isAfter(LocalDate.now().minusDays(30)))
                .mapToDouble(e -> e.amount)
                .sum();
        
        int overdueServices = (int) maintenanceRecords.stream()
                .filter(mr -> "Overdue".equals(mr.status))
                .count();
        
        int upcomingServices = (int) maintenanceRecords.stream()
                .filter(mr -> mr.nextDue.isBefore(LocalDate.now().plusDays(7)) 
                        && mr.nextDue.isAfter(LocalDate.now()))
                .count();
        
        StringBuilder sb = new StringBuilder();
        sb.append("=== VEHICLE MAINTENANCE SYSTEM DASHBOARD ===\n");
        sb.append("Last Updated: ").append(LocalDate.now()).append("\n\n");
        sb.append("SUMMARY:\n");
        sb.append(String.format("  * Total Vehicles: %d\n", totalVehicles));
        sb.append(String.format("  * Active Vehicles: %d\n", 
                vehicles.stream().filter(v -> "Active".equals(v.status)).count()));
        sb.append(String.format("  * Pending Maintenance: %d\n", pendingMaintenance));
        sb.append(String.format("  * Overdue Services: %d\n", overdueServices));
        sb.append(String.format("  * Upcoming Services (7 days): %d\n", upcomingServices));
        sb.append(String.format("  * Monthly Expenses: $%.2f\n\n", monthlyExpenses));
        
        sb.append("RECENT ACTIVITY:\n");
        maintenanceRecords.stream()
                .sorted((a, b) -> b.date.compareTo(a.date))
                .limit(5)
                .forEach(mr -> sb.append(String.format("  * %s: %s on %s ($%.2f)\n", 
                        mr.vehicle, mr.serviceType, mr.date, mr.cost)));
        
        sb.append("\nALERTS:\n");
        maintenanceRecords.stream()
                .filter(mr -> "Overdue".equals(mr.status))
                .forEach(mr -> sb.append(String.format("  ! OVERDUE: %s needs %s\n", 
                        mr.vehicle, mr.serviceType)));
        
        dashboardText.setText(sb.toString());
    }
    
    private void performSearch() {
        String query = searchField.getText().toLowerCase();
        String filter = (String) filterComboBox.getSelectedItem();
        
        if (query.isEmpty()) {
            refreshVehicleTable();
            refreshMaintenanceTable();
            refreshExpenseTable();
            return;
        }
        
        // Filter vehicles
        if ("All".equals(filter) || "Vehicles".equals(filter)) {
            vehicleTableModel.setRowCount(0);
            for (Vehicle v : vehicles) {
                if (v.make.toLowerCase().contains(query) ||
                    v.model.toLowerCase().contains(query) ||
                    v.licensePlate.toLowerCase().contains(query) ||
                    v.vin.toLowerCase().contains(query)) {
                    vehicleTableModel.addRow(new Object[]{
                        v.id, v.make, v.model, v.year, v.licensePlate, 
                        v.vin, v.mileage, v.status
                    });
                }
            }
        }
        
        // Filter maintenance
        if ("All".equals(filter) || "Maintenance".equals(filter)) {
            maintenanceTableModel.setRowCount(0);
            for (MaintenanceRecord mr : maintenanceRecords) {
                if (mr.vehicle.toLowerCase().contains(query) ||
                    mr.serviceType.toLowerCase().contains(query) ||
                    mr.status.toLowerCase().contains(query) ||
                    mr.notes.toLowerCase().contains(query)) {
                    maintenanceTableModel.addRow(new Object[]{
                        mr.id, mr.vehicle, mr.serviceType, mr.date.format(dateFormatter),
                        mr.nextDue.format(dateFormatter), String.format("$%.2f", mr.cost),
                        mr.status, mr.notes
                    });
                }
            }
        }
        
        // Filter expenses
        if ("All".equals(filter) || "Expenses".equals(filter)) {
            expenseTableModel.setRowCount(0);
            for (Expense exp : expenses) {
                if (exp.vehicle.toLowerCase().contains(query) ||
                    exp.category.toLowerCase().contains(query) ||
                    exp.description.toLowerCase().contains(query)) {
                    expenseTableModel.addRow(new Object[]{
                        exp.id, exp.vehicle, exp.category, exp.date.format(dateFormatter),
                        String.format("$%.2f", exp.amount), exp.description, exp.receipt
                    });
                }
            }
        }
    }
    
